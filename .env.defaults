# Subterra public defaults — committed to the repo.
#
# This file is loaded BEFORE .env so any value in your local .env wins.
# It holds non-secret defaults (URLs, public endpoints) so every install
# starts with the same source map without copy-pasting from .env.example.
#
# DO NOT put secrets here. Use .env (gitignored) for JWT_SECRET, DB
# passwords, S3 credentials, etc.

# --- Web ---
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/dark

# --- API ---
API_PORT=4000
API_HOST=0.0.0.0

# --- Upstream public data endpoints ---
# These are best-effort defaults. Verify with `npm run probe`.
# If an agency moves a service, override here OR in .env.

# BLM National Mining Claims (active polygons)
BLM_CLAIMS_LAYER=https://gis.blm.gov/arcgis/rest/services/mining/BLM_Natl_Mining_Claims/MapServer/0/query

# USGS Mineral Resources Data System (MRDS) WFS
USGS_MRDS_WFS=https://mrdata.usgs.gov/services/wfs/mrds
USGS_MRDS_TYPENAME=mrds
USGS_MRDS_SHOW=https://mrdata.usgs.gov/mrds/show-mrds.php

# State oil & gas commission point layers.
# These are OPT-IN: leave blank and the wells/well-laterals routes will
# skip the state cleanly. The agencies frequently reorganize their GIS
# catalogs, so we'd rather show "unavailable" than spam 23-second 500s
# on every request. Set these once you've verified a working URL in the
# agency's REST catalog:
#   ND: https://www.dmr.nd.gov/oilgas/
#   CO: https://ecmc.state.co.us/data2.html
#   WY: https://wogcc.wyo.gov/
#   TX: https://www.rrc.texas.gov/resource-center/research/gis-viewer/
ND_WELLS_LAYER=
CO_WELLS_LAYER=
WY_WELLS_LAYER=
TX_WELLS_LAYER=

# Well-bore lateral linestring layers (same pattern)
ND_WELL_LINES_LAYER=
CO_WELL_LINES_LAYER=

# OSM Overpass — free, key-less feed of mining + oil/gas features.
# Always reachable; the easiest layer to verify the app is working.
OVERPASS_URL=https://overpass-api.de/api/interpreter

# OSM Nominatim — free geocoder. ≤1 req/sec per Nominatim ToS.
NOMINATIM_URL=https://nominatim.openstreetmap.org/search
NOMINATIM_USER_AGENT=Subterra/0.1 (+https://github.com/salamndrgaming-lab/subterra)
