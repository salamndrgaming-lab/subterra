# Subterra public defaults — committed to the repo.
#
# This file is loaded BEFORE .env so any value in your local .env wins.
# It holds non-secret defaults (URLs, public endpoints) so every install
# starts with the same source map without copy-pasting from .env.example.
#
# DO NOT put secrets here. Use .env (gitignored) for JWT_SECRET, DB
# passwords, S3 credentials, etc.

# --- Web ---
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/dark

# --- API ---
API_PORT=4000
API_HOST=0.0.0.0

# --- Upstream public data endpoints ---
# These are best-effort defaults. Verify with `npm run probe`.
# If an agency moves a service, override here OR in .env.

# BLM National Mining Claims (active polygons)
BLM_CLAIMS_LAYER=https://gis.blm.gov/arcgis/rest/services/mining/BLM_Natl_Mining_Claims/MapServer/0/query

# USGS Mineral Resources Data System (MRDS) WFS
USGS_MRDS_WFS=https://mrdata.usgs.gov/services/wfs/mrds
USGS_MRDS_TYPENAME=mrds
USGS_MRDS_SHOW=https://mrdata.usgs.gov/mrds/show-mrds.php

# --- Nationwide oil/gas + mining fallback ---
# EPA Facility Registry Service. Every regulated facility in every state
# that has an NAICS 211 (oil & gas) or 2121/2122/2123 (mining) code. Free,
# nationwide, no key. Used as the always-on fallback in /api/layers/wells
# so a fresh install shows real data anywhere in the US without needing
# any state-level URL to be wired.
EPA_FRS_LAYER=https://geopub.epa.gov/arcgis/rest/services/EMEF/FRS_INTERESTS/MapServer/0/query

# --- State oil & gas commission spatial layers ---
# These are OPT-IN. Leave blank and the wells route will skip that state
# cleanly (EPA FRS still covers it nationally). The agencies frequently
# reorganize their GIS catalogs, so the URLs below are candidate paths
# we've seen published — run `npm run probe` after editing to verify any
# return 200. Each commented entry is a starting point: paste the URL
# (with ?f=json) into a browser to check, then uncomment + save.
#
# Format expected: any ArcGIS REST FeatureServer/MapServer layer URL
# ending in `/0/query` (no trailing parameters).

# Texas (Railroad Commission)
#   Catalog: https://www.rrc.texas.gov/resource-center/research/gis-viewer/
TX_WELLS_LAYER=
# TX_WELLS_LAYER=https://gis2.rrc.texas.gov/arcgis/rest/services/Wells/Wells/MapServer/0/query

# North Dakota (Industrial Commission / DMR)
#   Catalog: https://www.dmr.nd.gov/oilgas/
ND_WELLS_LAYER=
# ND_WELLS_LAYER=https://ndgishub.nd.gov/arcgis/rest/services/All_GIS_Data_OilGas/Oil_and_Gas_Well_Locations/MapServer/0/query

# Colorado (ECMC, formerly COGCC)
#   Catalog: https://ecmc.state.co.us/data2.html
CO_WELLS_LAYER=
# CO_WELLS_LAYER=https://services1.arcgis.com/zTagxbhxHBVOIYW6/arcgis/rest/services/Wells_Spatial/FeatureServer/0/query

# Wyoming (WOGCC)
#   Catalog: https://wogcc.wyo.gov/
WY_WELLS_LAYER=
# WY_WELLS_LAYER=https://services.arcgis.com/RmCCgQtiZLDFtw04/arcgis/rest/services/Wyoming_Oil_and_Gas_Wells/FeatureServer/0/query

# New Mexico (OCD)
#   Catalog: https://www.emnrd.nm.gov/ocd/
NM_WELLS_LAYER=
# NM_WELLS_LAYER=https://services.arcgis.com/iIuwYHwrkphM23ER/arcgis/rest/services/OCD_Wells/FeatureServer/0/query

# Oklahoma (OCC)
#   Catalog: https://oklahoma.gov/occ.html
OK_WELLS_LAYER=

# Kansas (KCC / KGS)
#   Catalog: https://maps.kgs.ku.edu/oilgas/
KS_WELLS_LAYER=

# Louisiana (DNR SONRIS)
#   Catalog: https://sonlite.dnr.state.la.us/sundown/cart_prod/cart_con_wellinfo
LA_WELLS_LAYER=

# California (CalGEM)
#   Catalog: https://www.conservation.ca.gov/calgem
CA_WELLS_LAYER=
# CA_WELLS_LAYER=https://gis.conservation.ca.gov/server/rest/services/WellSTAR/Wells/MapServer/0/query

# Alaska (AOGCC)
#   Catalog: https://aogcc.alaska.gov/
AK_WELLS_LAYER=

# Utah (DOGM)
#   Catalog: https://oilgas.ogm.utah.gov/oilgasweb/data-center/
UT_WELLS_LAYER=

# Montana (BOGC)
#   Catalog: http://www.bogc.dnrc.mt.gov/
MT_WELLS_LAYER=

# Pennsylvania (DEP)
#   Catalog: https://www.dep.pa.gov/Business/Energy/OilandGasPrograms/
PA_WELLS_LAYER=
# PA_WELLS_LAYER=https://services2.arcgis.com/xtUuRcvOnbvbpVnG/arcgis/rest/services/Oil_and_Gas_Locations/FeatureServer/0/query

# Ohio (DNR)
#   Catalog: https://gis.ohiodnr.gov/mapviewer/
OH_WELLS_LAYER=

# West Virginia (DEP)
#   Catalog: https://dep.wv.gov/oil-and-gas/
WV_WELLS_LAYER=

# Michigan (EGLE)
#   Catalog: https://www.michigan.gov/egle/
MI_WELLS_LAYER=

# Illinois (DNR)
#   Catalog: https://www.isgs.illinois.edu/maps-data-pub/wells
IL_WELLS_LAYER=

# Mississippi (MSOGB)
#   Catalog: https://www.ogb.state.ms.us/
MS_WELLS_LAYER=

# Alabama (OGB)
#   Catalog: https://www.gsa.state.al.us/ogb/
AL_WELLS_LAYER=

# Arkansas (AOGC)
#   Catalog: https://www.aogc.state.ar.us/
AR_WELLS_LAYER=

# Tennessee (TDEC)
#   Catalog: https://www.tn.gov/environment/program-areas/water-water/oil-and-gas.html
TN_WELLS_LAYER=

# Kentucky (DOGC)
#   Catalog: https://eec.ky.gov/Natural-Resources/Oil-and-Gas/
KY_WELLS_LAYER=

# Indiana (DNR)
#   Catalog: https://www.in.gov/dnr/oil-and-gas/
IN_WELLS_LAYER=

# Virginia (DMME)
#   Catalog: https://energy.virginia.gov/gas-oil/
VA_WELLS_LAYER=

# New York (DEC)
#   Catalog: https://www.dec.ny.gov/energy/1601.html
NY_WELLS_LAYER=

# Florida (DEP)
#   Catalog: https://floridadep.gov/water/mining-mitigation
FL_WELLS_LAYER=

# Nevada (mining state, oil/gas via NDOM)
#   Catalog: http://minerals.nv.gov/
NV_WELLS_LAYER=

# Arizona (AZOGCC)
#   Catalog: https://azogcc.az.gov/
AZ_WELLS_LAYER=

# Idaho (IDL)
#   Catalog: https://www.idl.idaho.gov/og/
ID_WELLS_LAYER=

# Oregon (DOGAMI)
#   Catalog: https://www.oregongeology.org/mlrr/
OR_WELLS_LAYER=

# Washington (DNR)
WA_WELLS_LAYER=

# South Dakota (DENR)
SD_WELLS_LAYER=

# Nebraska (NOGCC)
NE_WELLS_LAYER=

# --- Well-bore lateral linestring layers (same opt-in pattern) ---
ND_WELL_LINES_LAYER=
CO_WELL_LINES_LAYER=
WY_WELL_LINES_LAYER=
TX_WELL_LINES_LAYER=
NM_WELL_LINES_LAYER=
OK_WELL_LINES_LAYER=
CA_WELL_LINES_LAYER=
PA_WELL_LINES_LAYER=

# OSM Overpass — free, key-less feed of mining + oil/gas features.
# Always reachable; the easiest layer to verify the app is working.
OVERPASS_URL=https://overpass-api.de/api/interpreter

# OSM Nominatim — free geocoder. ≤1 req/sec per Nominatim ToS.
NOMINATIM_URL=https://nominatim.openstreetmap.org/search
NOMINATIM_USER_AGENT=Subterra/0.1 (+https://github.com/salamndrgaming-lab/subterra)
