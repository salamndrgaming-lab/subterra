# Subterra environment variables

# --- Database ---
DATABASE_URL=postgresql://subterra:subterra@localhost:5432/subterra
REDIS_URL=redis://localhost:6379

# --- API ---
API_PORT=4000
API_HOST=0.0.0.0
JWT_SECRET=replace-me-with-a-real-secret
JWT_REFRESH_SECRET=replace-me-with-a-different-real-secret
SESSION_TTL_SECONDS=86400

# --- Web ---
NEXT_PUBLIC_API_URL=http://localhost:4000
# Free MapLibre style — no key, no caps. Override to self-hosted Protomaps,
# Esri Dark Gray, or any MapLibre style URL.
NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/dark

# --- Upstream feature endpoints (override if the agency moves a service) ---
# Layer routes try these at request time. If a URL stops working, you can
# replace it here without rebuilding. Empty/unset = the source-default URL.
# When a URL returns 4xx/5xx the API gracefully returns an empty
# FeatureCollection + meta.unavailable rather than 500-ing the request.

# BLM National Mining Claims (active polygons)
BLM_CLAIMS_LAYER=https://gis.blm.gov/arcgis/rest/services/mining/BLM_Natl_Mining_Claims/MapServer/0/query

# USGS Mineral Resources Data System (MRDS) WFS
USGS_MRDS_WFS=https://mrdata.usgs.gov/services/wfs/mrds
USGS_MRDS_TYPENAME=mrds
USGS_MRDS_SHOW=https://mrdata.usgs.gov/mrds/show-mrds.php

# State oil & gas commission point layers
ND_WELLS_LAYER=https://ndgishub.nd.gov/arcgis/rest/services/All_GIS_Data_OilGas/Oil_and_Gas_Well_Locations/MapServer/0/query
CO_WELLS_LAYER=https://services1.arcgis.com/zTagxbhxHBVOIYW6/arcgis/rest/services/Wells_Spatial/FeatureServer/0/query
WY_WELLS_LAYER=https://services.arcgis.com/RmCCgQtiZLDFtw04/arcgis/rest/services/Wyoming_Oil_and_Gas_Wells/FeatureServer/0/query
TX_WELLS_LAYER=https://gis2.rrc.texas.gov/arcgis/rest/services/Wells/Wells/MapServer/0/query

# Well-bore lateral (linestring) layers
ND_WELL_LINES_LAYER=https://ndgishub.nd.gov/arcgis/rest/services/All_GIS_Data_OilGas/Wellbore_Lines/MapServer/0/query
CO_WELL_LINES_LAYER=https://services1.arcgis.com/zTagxbhxHBVOIYW6/arcgis/rest/services/Wells_Lines/FeatureServer/0/query

# OSM Nominatim geocoder (free, ≤1 req/sec). Override to a self-hosted
# Nominatim instance for higher throughput.
NOMINATIM_URL=https://nominatim.openstreetmap.org/search
NOMINATIM_USER_AGENT=Subterra/0.1 (+https://github.com/salamndrgaming-lab/subterra)
