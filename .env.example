# ─── Cloudflare ────────────────────────────────────────────────────────
# Account ID — Cloudflare dashboard → right sidebar
CLOUDFLARE_ACCOUNT_ID=

# API token — Cloudflare dashboard → My Profile → API Tokens → Create Token
# Permissions needed: Workers Scripts:Edit, D1:Edit, R2:Edit, Pages:Edit
CLOUDFLARE_API_TOKEN=

# D1 database ID — Cloudflare dashboard → Workers & Pages → D1 → subterra
CLOUDFLARE_D1_DATABASE_ID=

# R2 bucket name — created in Cloudflare dashboard → R2
CLOUDFLARE_R2_BUCKET=subterra-tiles

# ─── Public URLs the web app calls ─────────────────────────────────────
# Where the Worker is deployed. For local dev, wrangler dev publishes at
# http://localhost:8787 by default.
VITE_API_URL=http://localhost:8787

# Where R2 serves the published tile bundle. Cloudflare R2 public bucket
# URL or a Worker route in front of it. Set this after deploying tiles.
VITE_TILES_BASE_URL=https://tiles.subterra.app

# ─── Auth (Phase 4+) ───────────────────────────────────────────────────
# Random 32+ character string — used to sign JWT session cookies issued
# after WebAuthn passkey verification. Generate with:
#   node -e "console.log(crypto.randomBytes(48).toString('base64url'))"
AUTH_JWT_SECRET=

# WebAuthn relying-party ID — your production domain (no scheme).
# For local dev use "localhost".
AUTH_RP_ID=localhost

# ─── Stripe (Phase 7+) ─────────────────────────────────────────────────
# Stripe secret key — dashboard.stripe.com → Developers → API keys
STRIPE_SECRET_KEY=

# Stripe webhook signing secret — dashboard.stripe.com → Developers →
# Webhooks → your endpoint → Signing secret
STRIPE_WEBHOOK_SECRET=

# ─── Email (Phase 6+) ──────────────────────────────────────────────────
# Resend API key — resend.com → API Keys
RESEND_API_KEY=

# From-address for alert emails. Must be a verified sender on Resend.
RESEND_FROM=alerts@subterra.app

# ─── Error monitoring (optional) ───────────────────────────────────────
# Sentry DSN — sentry.io → Project Settings → Client Keys
SENTRY_DSN_WEB=
SENTRY_DSN_API=

# ─── ETL (only used by the weekly GitHub Actions job) ──────────────────
# EIA series API key (commodity prices). Free at:
#   https://www.eia.gov/opendata/register.php
EIA_API_KEY=
