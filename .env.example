# Subterra environment variables

# --- Database ---
DATABASE_URL=postgresql://subterra:subterra@localhost:5432/subterra
REDIS_URL=redis://localhost:6379

# --- API ---
API_PORT=4000
API_HOST=0.0.0.0
JWT_SECRET=replace-me-with-a-real-secret
JWT_REFRESH_SECRET=replace-me-with-a-different-real-secret
SESSION_TTL_SECONDS=86400

# --- Web ---
NEXT_PUBLIC_API_URL=http://localhost:4000
# Free MapLibre style — no key, no caps. Override to self-hosted Protomaps,
# Esri Dark Gray, or any MapLibre style URL. See packages/shared/src/constants/sources.ts.
NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/dark

# --- Storage ---
S3_BUCKET=subterra-assets
S3_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_ENDPOINT=

# --- ETL: state oil & gas commissions ---
TX_RRC_API=https://www.rrc.texas.gov/oil-gas/research-and-statistics/
NDIC_API=https://www.dmr.nd.gov/oilgas/
COGCC_API=https://ecmc.state.co.us/data2.html

# --- ETL: federal ---
BLM_MLRS_BASE=https://reports.blm.gov/reports/MLRS
USGS_MRDS_URL=https://mrdata.usgs.gov/mrds/
