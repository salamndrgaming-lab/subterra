{
  "name": "@subterra/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Subterra desktop wrapper — bundles the API + Next.js web app + MapLibre into a single Windows / macOS / Linux executable.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  }
}
