{
  "appId": "app.subterra.desktop",
  "productName": "Subterra",
  "electronVersion": "33.2.0",
  "nodeGypRebuild": false,
  "asar": true,
  "directories": {
    "output": "dist",
    "buildResources": "build"
  },
  "files": [
    "main.js",
    "preload.js",
    "package.json"
  ],
  "extraResources": [
    {
      "from": "../../apps/api/dist",
      "to": "app/apps/api/dist",
      "filter": ["**/*"]
    },
    {
      "from": "../../apps/web/.next/standalone",
      "to": "app/apps/web/.next/standalone",
      "filter": ["**/*"]
    },
    {
      "from": "../../apps/web/.next/static",
      "to": "app/apps/web/.next/standalone/apps/web/.next/static",
      "filter": ["**/*"]
    },
    {
      "from": "../../apps/web/public",
      "to": "app/apps/web/.next/standalone/apps/web/public",
      "filter": ["**/*"]
    },
    {
      "from": "../../node_modules",
      "to": "app/node_modules",
      "filter": [
        "**/*",
        "!**/*.md",
        "!**/*.markdown",
        "!**/test/**",
        "!**/tests/**",
        "!**/*.d.ts",
        "!**/*.map",
        "!**/.bin/**",
        "!**/typescript/**",
        "!**/tsx/**",
        "!**/@types/**",
        "!**/@mapbox/**",
        "!**/electron/**",
        "!**/electron-builder/**",
        "!**/mapbox-gl/**",
        "!**/maplibre-gl/**",
        "!**/recharts/**",
        "!**/next/**",
        "!**/react/**",
        "!**/react-dom/**",
        "!**/tailwindcss/**",
        "!**/postcss/**",
        "!**/autoprefixer/**"
      ]
    }
  ],
  "win": {
    "target": [
      { "target": "portable", "arch": ["x64"] }
    ],
    "artifactName": "Subterra-${version}-portable.${ext}"
  },
  "mac": {
    "target": [
      { "target": "dmg", "arch": ["x64", "arm64"] }
    ],
    "category": "public.app-category.utilities"
  },
  "linux": {
    "target": [
      { "target": "AppImage", "arch": ["x64"] }
    ],
    "category": "Utility"
  }
}
