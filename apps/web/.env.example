# Free MapLibre vector-tile basemap. No key, no usage caps. Override with
# any MapLibre style URL (e.g. self-hosted Protomaps PMTiles serving a
# stylesheet) or set to a different OpenFreeMap style.
NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/dark
